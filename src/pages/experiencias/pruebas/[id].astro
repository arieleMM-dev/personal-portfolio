---
import { experiences, galleryWorks } from '../../../data/experiences';
import '../../../styles/experience-demo.scss';
export function getStaticPaths() { return galleryWorks.map(work=>({params:{id:work.id},props:{work}})); }
const {work}=Astro.props;
const copy=experiences.es;
const base=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" /><meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500&family=Playfair+Display:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />
    <title>{work.title.es} — {copy.demoLabel}</title>
  </head>
  <body style={`--study-tone:${work.color}`} data-demo-id={work.id}>
    <main>
      <p class="demo-label"><span data-demo-copy="demoLabel">{copy.demoLabel}</span> · {work.number}</p>
      <h1 data-demo-title>{work.title.es}</h1>
      <p class="demo-description" data-demo-description>{work.description.es}</p>
      <p class="demo-note" data-demo-copy="demoBody">{copy.demoBody}</p>
      <a href={`${base}experiencias/#obra-${work.id}`} target="_top" data-demo-return><span aria-hidden="true">←</span><span data-demo-copy="close">{copy.close}</span></a>
    </main>
    <script>
      import { experiences, getGalleryWork } from '../../../data/experiences';
      const lang=new URLSearchParams(location.search).get('lang')==='en'?'en':'es';
      const copy=experiences[lang];const work=getGalleryWork(document.body.dataset.demoId??'');
      document.documentElement.lang=lang;
      document.querySelectorAll<HTMLElement>('[data-demo-copy]').forEach(element=>{const key=element.dataset.demoCopy as keyof typeof copy;if(key in copy)element.textContent=copy[key];});
      if(work){document.querySelector('[data-demo-title]')!.textContent=work.title[lang];document.querySelector('[data-demo-description]')!.textContent=work.description[lang];document.title=`${work.title[lang]} — ${copy.demoLabel}`;}
      const close=()=>{if(parent!==window)parent.postMessage({type:'gallery:close-preview'},location.origin);};
      document.querySelector('[data-demo-return]')?.addEventListener('click',event=>{if(parent!==window){event.preventDefault();close();}});
      document.addEventListener('keydown',event=>{if(event.key==='Escape'&&parent!==window){event.preventDefault();close();}});
    </script>
  </body>
</html>
