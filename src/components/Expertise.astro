---
import { columns } from '../data/expertise';
import { translations } from '../data/translations';
import TechnologyList from './TechnologyList.astro';
---
<section class="expertise portfolio-section" id="expertise" data-expertise aria-labelledby="expertise-title">
  <div class="section-head" data-reveal>
    <p class="section-kicker"><span data-i18n="expertise.label">Conocimientos</span></p>
    <h2 id="expertise-title" class="section-title" data-expertise-title data-i18n="expertise.title">Las piezas detrás<br /><span>de cada solución.</span></h2>
    <p class="section-copy" data-i18n="expertise.subtitle">Tecnologías que he usado en proyectos y en las que sigo profundizando.</p>
  </div>
  <div class="expertise__grid" data-expertise-grid>
    {columns.map((col, i) => (
      <article class="expertise__column" data-expertise-col>
        <div class={`expertise__visual expertise__visual--${i}`} data-ambient-motion aria-hidden="true">
          {Array.from({ length: 5 }, (_, n) => <span style={`--layer: ${n}`}></span>)}
        </div>
        <h3 class="expertise__col-title" data-i18n={col.titleKey}>{translations.es[col.titleKey]}</h3>
        <p class="expertise__col-desc" data-i18n={col.descKey}>{translations.es[col.descKey]}</p>
        <TechnologyList technologies={col.techs} />
      </article>
    ))}
  </div>
</section>
