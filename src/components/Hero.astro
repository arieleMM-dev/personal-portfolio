---
import { SITE } from '../data/site';

const { nameHero, subtitle } = SITE;
const letters = nameHero.split('');
---

<section class="hero" id="home" data-hero>
  <div class="hero__content" data-hero-content>
    <h1 class="hero__title text-5xl md:text-7xl lg:text-[9vw] font-black leading-none font-heading uppercase" data-hero-title aria-label={nameHero}>
      {
        letters.map((letter) => (
          <span class="hero__letter" data-hero-letter>
            {letter === ' ' ? '\u00A0' : letter}
          </span>
        ))
      }
    </h1>
    <p class="hero__subtitle" data-hero-subtitle>
      <span class="hero__subtitle-text text-sm md:text-base lg:text-lg font-bold tracking-[0.3em] uppercase font-heading" data-hero-subtitle-text data-i18n="hero.subtitle">{subtitle}</span>
      <span class="hero__dot" data-hero-dot aria-hidden="true">&bull;</span>
    </p>
  </div>
</section>
