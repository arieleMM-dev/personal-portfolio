---
import { SITE } from '../data/site';

const { nameHero, subtitle } = SITE;
const letters = nameHero.split('');
---

<section class="hero" id="home" data-hero>
  <div class="hero__environment" aria-hidden="true">
    <canvas class="hero__scene" data-hero-scene></canvas>
    <div class="hero__vignette"></div>
  </div>
  <div class="hero__content" data-hero-content>
    <h1 class="hero__title font-black leading-none font-heading uppercase" data-hero-title aria-label={nameHero}>
      {
        letters.map((letter) => (
          <span class="hero__letter" data-hero-letter>
            {letter === ' ' ? '\u00A0' : letter}
          </span>
        ))
      }
    </h1>
    <p class="hero__subtitle" data-hero-subtitle>
      <span class="hero__subtitle-text text-sm md:text-base lg:text-lg font-bold tracking-[0.3em] uppercase font-heading" data-hero-subtitle-text data-i18n="hero.subtitle">{subtitle}</span>
      <span class="hero__dot" data-hero-dot aria-hidden="true">&bull;</span>
    </p>
  </div>
  <p class="hero__scroll-cue" data-hero-scroll-cue>
    <svg width="12" height="18" viewBox="0 0 12 18" fill="none" aria-hidden="true">
      <path d="M6 1v14m-4-4 4 4 4-4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span><span lang="en">Scroll to explore</span><span aria-hidden="true"> | </span><span lang="es">Desliza para explorar</span></span>
  </p>
  <div class="hero__controls">
  <button class="hero__motion" type="button" data-motion-toggle aria-label="Pausar ambiente" aria-pressed="false">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><g class="motion-pause" stroke="currentColor" stroke-width="1.5"><path d="M5 3v10M11 3v10"/></g><path class="motion-play" d="m5 3 8 5-8 5V3Z" stroke="currentColor" stroke-linejoin="round"/></svg>
    <span data-motion-label>Pausar ambiente</span>
  </button>
  </div>
  <span class="sr-only" role="status" data-audio-status></span>
</section>
