---
import { SITE } from '../data/site';
import { translations as labels } from '../data/translations';

const { nav, nameShort } = SITE;

---

<header class="header px-4 sm:px-8 md:px-16 lg:px-24" data-header>
  <a href="#home" class="header__brand text-3xl font-bold uppercase tracking-widest font-heading" data-nav-link>{nameShort}</a>

  <nav aria-label="Principal" class="header__nav-wrapper">
    <ul class="header__nav">
      {
        nav.map((item) => (
          <li>
            <a href={item.href === '#web-experiences' ? `${import.meta.env.BASE_URL}experiencias/` : item.href} class="header__nav-link text-base lg:text-lg" data-nav-link data-nav-section={item.href.slice(1)} aria-label={labels.es[`nav.${item.label.toLowerCase()}`]} data-i18n-aria-label={`nav.${item.label.toLowerCase()}`}>
              <span class="nav-text" data-scramble-label data-i18n={`nav.${item.label.toLowerCase()}`}>{labels.es[`nav.${item.label.toLowerCase()}`]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button class="header__lang-toggle" data-lang-toggle aria-label="Toggle language">
    <span class="header__lang-text is-active" data-lang="en">EN</span>
    <span class="header__lang-sep">|</span>
    <span class="header__lang-text" data-lang="es">ES</span>
  </button>
</header>

<header class="header header--sticky px-4 sm:px-8 md:px-16 lg:px-24" data-header-sticky aria-hidden="true" inert>
  <nav aria-label="Principal fijo" class="header__nav-wrapper">
    <ul class="header__nav">
      {
        nav.map((item) => (
          <li>
            <a href={item.href === '#web-experiences' ? `${import.meta.env.BASE_URL}experiencias/` : item.href} class="header__nav-link text-base lg:text-lg" data-nav-link data-nav-section={item.href.slice(1)} aria-label={labels.es[`nav.${item.label.toLowerCase()}`]} data-i18n-aria-label={`nav.${item.label.toLowerCase()}`}>
              <span class="nav-text" data-scramble-label data-i18n={`nav.${item.label.toLowerCase()}`}>{labels.es[`nav.${item.label.toLowerCase()}`]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <button class="header__lang-toggle" data-lang-toggle aria-label="Toggle language">
    <span class="header__lang-text is-active" data-lang="en">EN</span>
    <span class="header__lang-sep">|</span>
    <span class="header__lang-text" data-lang="es">ES</span>
  </button>
</header>

<script>
  import { translations } from '../data/translations';
  import { projects, type Language } from '../data/work';

  const LANG_STORAGE_KEY = 'portfolio-lang';
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-lang-toggle]');
  const stickyHeader = document.querySelector<HTMLElement>('[data-header-sticky]');
  // Menus can wrap differently with viewport size, zoom and locale.
  const headerSize = new ResizeObserver(() => {
    if (stickyHeader) document.documentElement.style.setProperty('--header-clearance', `${stickyHeader.offsetHeight + 24}px`);
  });
  if (stickyHeader) headerSize.observe(stickyHeader);
  window.addEventListener('pagehide', event => { if (!event.persisted) headerSize.disconnect(); });
  
  let savedLang: Language = navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
  try {
    const stored = localStorage.getItem(LANG_STORAGE_KEY);
    if (stored === 'es' || stored === 'en') savedLang = stored;
  } catch { /* Browser language remains usable when storage is unavailable. */ }
  document.documentElement.setAttribute('lang', savedLang);
  
  function updateTranslations(lang: Language) {
    const dict = { ...translations[lang] };
    Object.entries(projects).forEach(([id, project]) => {
      dict[`work.${id}.title`] = project.displayTitle[lang];
      dict[`work.${id}.short`] = project.short[lang];
      dict[`work.${id}.open`] = `${dict['work.viewProject']}: ${project.displayTitle[lang]}`;
    });
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) {
        // Use innerHTML to support span highlighting like in About Me
        el.innerHTML = dict[key];
      }
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach(el => {
      const key = el.dataset.i18nAriaLabel;
      if (key && dict[key]) el.setAttribute('aria-label', dict[key]);
    });
    document.title = dict['meta.title'];
    document.querySelectorAll<HTMLMetaElement>('meta[name="description"], meta[property="og:description"], meta[name="twitter:description"]').forEach(meta => { meta.content = dict['meta.description']; });
    document.querySelectorAll<HTMLMetaElement>('meta[property="og:title"], meta[name="twitter:title"]').forEach(meta => { meta.content = dict['meta.title']; });
    document.querySelector<HTMLMetaElement>('meta[property="og:locale"]')?.setAttribute('content', lang === 'es' ? 'es_ES' : 'en_US');
    document.querySelector<HTMLMetaElement>('meta[property="og:locale:alternate"]')?.setAttribute('content', lang === 'es' ? 'en_US' : 'es_ES');
    document.querySelectorAll<HTMLAnchorElement>('[data-scroll-tracker-link]').forEach(link => {
      const navKey = `nav.${link.dataset.scrollTrackerLink}`;
      if (dict[navKey]) link.setAttribute('aria-label', dict[navKey]);
    });
  }

  function updateToggleUI(lang: string) {
    toggles.forEach(toggle => {
      toggle.setAttribute('aria-label', lang === 'es' ? 'Cambiar a inglés' : 'Switch to Spanish');
      const texts = toggle.querySelectorAll<HTMLElement>('[data-lang]');
      texts.forEach(t => {
        if (t.getAttribute('data-lang') === lang) {
          t.classList.add('is-active');
        } else {
          t.classList.remove('is-active');
        }
      });
    });
  }
  
  updateToggleUI(savedLang);
  updateTranslations(savedLang);

  // The other area can change locale while this document is in the back/forward cache.
  window.addEventListener('pageshow', event => {
    if (!event.persisted) return;
    try {
      const lang = localStorage.getItem(LANG_STORAGE_KEY);
      if ((lang !== 'es' && lang !== 'en') || lang === document.documentElement.lang) return;
      document.documentElement.lang = lang;
      updateToggleUI(lang);
      updateTranslations(lang);
      document.dispatchEvent(new CustomEvent('portfolio:language-change'));
    } catch { /* The current locale remains usable without storage. */ }
  });

  toggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const currentLang = document.documentElement.getAttribute('lang') || 'en';
      const newLang: Language = currentLang === 'en' ? 'es' : 'en';
      
      document.documentElement.setAttribute('lang', newLang);
      try { localStorage.setItem(LANG_STORAGE_KEY, newLang); } catch { /* Language switching must still work. */ }
      updateToggleUI(newLang);
      updateTranslations(newLang);
      document.dispatchEvent(new CustomEvent('portfolio:language-change'));
    });
  });
</script>
