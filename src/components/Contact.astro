---
import { contactLinks } from '../data/contact';
---
<footer class="contact portfolio-section" id="contact" data-contact aria-labelledby="contact-title">
  <div class="contact__horizon" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="contact__inner" data-contact-inner data-reveal>
    <p class="section-kicker"><span data-i18n="contact.label">Contacto</span></p>
    <p class="availability"><span class="status-dot" aria-hidden="true"></span><span data-i18n="common.available">Disponible para nuevos retos</span></p>
    <h2 id="contact-title" class="section-title contact__title" data-contact-title data-i18n="contact.title">Una buena idea<br /><span>empieza hablando.</span></h2>
    <p class="section-copy" data-i18n="contact.subtitle">¿Un proyecto, una oportunidad o una conversación sobre software? Me gustaría escucharte.</p>
    <div class="contact__actions">
      <button type="button" class="button-primary" data-compose-email><span data-i18n="contact.cta">Hablemos</span><span aria-hidden="true">↗</span></button>
      <button type="button" class="contact__email" data-copy-email>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V4H4V16H8"/></svg>
        <span data-copy-label data-i18n="contact.copy">Copiar correo</span>
      </button>
    </div>
    <p class="contact__feedback" data-copy-feedback role="status" aria-live="polite"></p>
    <nav class="contact__links" aria-label="Social links">
      {contactLinks.map(link => (
        <a href={link.href} class="text-link" {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          <span>{link.label}</span><span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <noscript><p class="section-copy" data-i18n="contact.noScript">Activa JavaScript para usar los botones de correo.</p></noscript>
  </div>
</footer>
