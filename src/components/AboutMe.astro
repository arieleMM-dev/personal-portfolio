---
import { translations } from '../data/translations';
import AboutProcess from './AboutProcess.astro';
import SystemGlyph from './SystemGlyph.astro';
const stages = ['api', 'logic', 'data'] as const;
---
<section class="about portfolio-section" id="about" data-about aria-labelledby="about-title">
  <div class="section-head" data-reveal>
    <p class="section-kicker"><span data-i18n="about.title">Sobre mí</span></p>
    <h2 id="about-title" class="section-title" data-about-title data-i18n="about.headline">Backend con propósito.<br /><span>Software con criterio.</span></h2>
  </div>
  <div class="about__grid">
    <div class="about__profile" data-about-text data-reveal>
      <p class="about__intro" data-i18n="about.intro">Soy Ariel, estudiante de Ingeniería de Software. Construyo backend y lógica de negocio para convertir necesidades reales en software que funciona.</p>
      <p class="section-copy" data-i18n="about.body">Trabajo con Node.js y TypeScript. Me interesa entender cómo encajan las piezas de un sistema complejo y profundizar en su arquitectura: responsabilidades claras, pruebas y decisiones que permitan crecer.</p>
      <div class="about__facts">
        <div><span class="micro-label" data-i18n="about.focusLabel">Enfoque</span><strong data-i18n="about.focus">Backend & sistemas</strong></div>
        <div><span class="micro-label" data-i18n="about.learningLabel">Explorando</span><strong data-i18n="about.learning">Arquitectura & DevOps</strong></div>
      </div>
      <a class="availability" href="#contact" data-nav-link><span class="status-dot" aria-hidden="true"></span><span data-i18n="common.available">Disponible para nuevos retos</span><span aria-hidden="true">↗</span></a>
    </div>
  </div>
    <div class="architecture" data-reveal data-architecture data-active-stage="api">
      <div class="panel-meta"><span class="micro-label" data-i18n="about.system">Cómo pienso un sistema</span><span aria-hidden="true">REQUEST → RESPONSE</span></div>
      <div class="architecture__scenes">
        {stages.map((stage, i) => (
          <div id={`architecture-${stage}`} data-architecture-panel={stage} hidden={i !== 0}>
            <AboutProcess stage={stage as "api" | "logic" | "data"} />
          </div>
        ))}
      </div>
      <div class="architecture__steps" role="group" aria-label="Capas del sistema" data-i18n-aria-label="about.system">
        {stages.map((stage, i) => (
          <button type="button" class:list={['architecture__step', { 'is-active': i === 0 }]} data-architecture-stage={stage} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`architecture-${stage}`}>
            <span class="architecture__card-icon" aria-hidden="true"><SystemGlyph kind={stage} /></span>
            <span class="architecture__card-copy"><strong data-i18n={`about.${stage}.label`}>{translations.es[`about.${stage}.label`]}</strong><span data-i18n={`explorer.${stage}.summary`}>{translations.es[`explorer.${stage}.summary`]}</span></span>
            <span class="architecture__card-action" aria-hidden="true">↗</span>
            <span class="architecture__timer" aria-hidden="true"><span data-stage-progress></span></span>
          </button>
        ))}
      </div>
      <div class="architecture__controls"><p class="architecture__hint" data-i18n="about.hint">Explora cada capa del sistema</p><button type="button" class="architecture__toggle" data-architecture-toggle aria-pressed="false"><span data-cycle-label data-i18n="explorer.pause">Pausar recorrido</span><span aria-hidden="true">Ⅱ</span></button></div>
    </div>
</section>
