---
import { GALLERY_HANDOFF_KEY, GALLERY_HANDOFF_TTL } from '../scripts/gallery/transitionState';
import '../styles/gallery-transition.css';
---
<script is:inline define:vars={{handoffKey:GALLERY_HANDOFF_KEY,maxAge:GALLERY_HANDOFF_TTL}}>
  try {
    const root=document.documentElement;
    const raw=sessionStorage.getItem(handoffKey),handoff=raw?JSON.parse(raw):null;
    const path=value=>value.replace(/\/+$/,'')||'/';
    const paused=localStorage.getItem('portfolio-motion')==='paused'||matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!paused&&handoff&&(handoff.mode==='enter'||handoff.mode==='return')&&typeof handoff.path==='string'&&typeof handoff.time==='number'&&Date.now()-handoff.time>=0&&Date.now()-handoff.time<maxAge&&path(handoff.path)===path(location.pathname)) {
      root.dataset.galleryArrival=handoff.mode;
      root.style.setProperty('--gallery-arrival-blur','16px');
      window.addEventListener('pagereveal',event=>event.viewTransition?.skipTransition(),{once:true});
      // Release the page even if a client bundle or WebGL fails to load.
      setTimeout(()=>{
        if(!root.dataset.galleryArrival)return;
        delete root.dataset.galleryArrival;root.style.removeProperty('--gallery-arrival-blur');
        const white=document.querySelector('[data-gallery-white]');if(white)white.style.opacity='0';
        document.body.inert=false;
      },8000);
    }else if(raw)sessionStorage.removeItem(handoffKey);
  }catch{ /* Native links remain usable without storage. */ }
</script>
<div class="gallery-transition" aria-hidden="true">
  <svg width="0" height="0" focusable="false"><defs>
    <filter id="gallery-liquid-filter" x="-15%" y="-20%" width="130%" height="140%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.006 0.018" numOctaves="2" seed="8" result="flow" />
      <feGaussianBlur in="flow" stdDeviation="1.5" result="water" />
      <feDisplacementMap in="SourceGraphic" in2="water" scale="0" xChannelSelector="R" yChannelSelector="G" data-gallery-displacement />
    </filter>
  </defs></svg>
  <div class="gallery-transition__white" data-gallery-white></div>
</div>
<script>
  import { initGalleryTransition } from '../scripts/galleryTransition';
  initGalleryTransition();
</script>
