---
import { translations } from '../data/translations';

interface Props { placement?: 'header' | 'contact' }
const { placement = 'header' } = Astro.props;
---

<a href={`${import.meta.env.BASE_URL}experiencias/`} class:list={['experiences-link', `experiences-link--${placement}`]} data-nav-link>
  <span data-scramble-label data-i18n="experiences.link">{translations.es['experiences.link']}</span>
  <span class="experiences-link__arrow" aria-hidden="true">→</span>
</a>
